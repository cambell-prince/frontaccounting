{
    "variables": {
        "ref": "HEAD",
        "release": "build/release",
        "components": "modules/graphql|https://github.com/saygoweb/frontaccounting-module-graphql.git|main modules/mcp|https://github.com/saygoweb/frontaccounting-module-mcp.git|main modules/sgw_sales|https://github.com/saygoweb/frontaccounting-module-sgw_sales.git|master modules/sgw_import|https://github.com/saygoweb/frontaccounting-module-sgw_import.git|master",
        "php": "7.4.33",
        "user": "",
        "host": "aws1.saygoweb.com",
        "path": "bms/htdocs/",
        "max_deletes": "",
        "remote_user": "",
        "confirm": "no",
        "db_ssh": "root@saygoweb.com",
        "db": "saygoweb_fa",
        "db_opts": "",
        "file": ""
    },
    "release": {
        "by": [
            "sh deploy/build-release.sh '{{ref}}' '{{release}}' '{{components}}' '{{php}}'"
        ]
    },
    "deploy-check": {
        "by": [
            "sh deploy/upload.sh check '{{release}}' '{{user}}' '{{host}}' '{{path}}' '{{remote_user}}' '{{max_deletes}}'"
        ]
    },
    "deploy": {
        "by": [
            "sh deploy/upload.sh go '{{release}}' '{{user}}' '{{host}}' '{{path}}' '{{remote_user}}' '{{confirm}}'"
        ]
    },
    "deploy-previous": {
        "by": [
            "sh deploy/upload.sh previous '{{release}}' '{{user}}' '{{host}}' '{{path}}' '{{remote_user}}'"
        ]
    },
    "package": {
        "by": [
            "set -e; test -f '{{release}}.ok' || { echo 'package: run make.phar release first' >&2; exit 1; }; v=$(sed -n 's/^\\$src_version = \"\\(.*\\)\";/\\1/p' version.php); tar -czf build/frontaccounting-$v.tgz -C '{{release}}' --transform 's,^\\.,frontaccounting,' .; echo \"==> build/frontaccounting-$v.tgz\""
        ]
    },
    "db-backup": {
        "by": [
            "sh deploy/db-backup.sh '{{db_ssh}}' '{{db}}' '{{db_opts}}'"
        ]
    },
    "db-load": {
        "by": [
            "set -e; test -n '{{file}}' || { echo 'db-load: pass file=backup/<dump>.sql.gz' >&2; exit 1; }; docker/fa db reset '{{file}}'"
        ]
    },
    "test": {
        "by": [
            "docker/fa test"
        ]
    },
    "clean": {
        "by": [
            "rm -rf build log"
        ]
    }
}
