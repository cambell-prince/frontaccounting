# Settings for the docker/ test stack. Copy to docker/.env, or let
# `docker/fa init` write one with ports that are free on this machine.
#
# Every value here is a default that docker/fa already applies — this file
# exists to show what can be changed, not because anything must be.

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------

# Containers and the database volume are named after this. It defaults to
# fa-<checkout directory name>, which is what keeps a worktree's stack separate
# from the main checkout's.
#COMPOSE_PROJECT_NAME=fa-frontaccounting

# ---------------------------------------------------------------------------
# Host ports
# ---------------------------------------------------------------------------

#HTTP_PORT=8080
#DB_PORT=3307
#PMA_PORT=8081

# ---------------------------------------------------------------------------
# Versions
# ---------------------------------------------------------------------------

# FrontAccounting 2.4.x is written against PHP 5.4-7.x, and 7.4 is the newest
# version it is known to run on — .devcontainer uses 7.4 too. 8.x will build,
# but expect deprecation noise and genuine breakage in core.
#PHP_VERSION=7.4

# 10.4 is what .devcontainer pins, if you want exact parity with it.
#MARIADB_VERSION=10.11

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# `docker/fa config` writes these into config_db.php.
#
# Leave DB_NAME alone unless you do not care about the PHPUnit suite: it refuses
# to run against any database not called 'fa_test' (TestEnvironment::isGoodToGo),
# so that a suite which writes and deletes rows can never touch a real one.
#DB_NAME=fa_test
#DB_USER=fa
#DB_PASSWORD=fa
#DB_ROOT_PASSWORD=fa

# The table prefix. Datasets ship with 0_ baked in; anything else is rewritten
# as it loads.
#DB_PREFIX=0_

# What `docker/fa up` loads into an empty database, and the default for
# `docker/fa db reset`: test, demo-fixture, new or demo.
#SEED=test

# ---------------------------------------------------------------------------
# PHP
# ---------------------------------------------------------------------------

# Leave xdebug off unless you are actually attaching to it — it costs real time
# on every request. "debug" enables step debugging on port 9003, triggered by
# XDEBUG_TRIGGER; "coverage" is what phpunit --coverage-html needs.
#XDEBUG_MODE=off

# The extension is compiled in unless this is false at build time.
#INSTALL_XDEBUG=true

#FA_TIMEZONE=UTC

# ---------------------------------------------------------------------------
# Host user
# ---------------------------------------------------------------------------

# Apache runs as www-data remapped to these so files it writes into the
# bind-mounted checkout stay yours. docker/fa fills them in from `id -u`/`id -g`.
#USER_UID=1000
#USER_GID=1000
